{
  "name": "eve-cut",
  "version": "0.1.0",
  "private": true,
  "description": "Painel do Adobe Premiere Pro para legendas, limpeza e templates dos clientes da Eve Company.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev:panel": "pnpm build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-install-panel.ps1",
    "mcp:register": "node -e \"console.log('mcp:register: a implementar')\"",
    "lint": "eslint . && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
